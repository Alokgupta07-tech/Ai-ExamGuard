{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI ExamGuard Secure Client",
  "version": "0.2.0",
  "identifier": "com.aiexamguard.secureclient",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI ExamGuard — High-Stakes Secure Examination Environment",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https: http: wss: ws: blob: data: 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

